"""Untrusted-text handling: strip instruction-like lines, redact identifiers.

This is a tripwire, not the defence. The defence is that nothing the model
(or the ticket text) says can change the refund decision -- see policy.py.
A regex list will be bypassed; what it buys us is (a) a clean text for the
model, and (b) a reliable needs_human flag for the obvious attempts.
"""
import re
from .logsafe import scrub

_INJECTION = [re.compile(p, re.I) for p in [
    r"ignore (all |your |any |the )?(previous |prior |above )?(instructions|rules|polic)",
    r"\bsystem (note|prompt|message|override)\b",
    r"\bfor the (support |automated )?(assistant|agent|ai|bot|llm|model)\b",
    r"(reveal|print|show|repeat|share|reply with).{0,50}(system prompt|instructions|internal .{0,15}rules)",
    r"(approve|issue|process).{0,30}refund.{0,40}(immediately|now|all payments)",
    r"mark (this )?ticket (as )?resolved",
    r"verified (vip|admin|user)",
    r"\byou are now\b|\bjailbreak\b|developer mode",
]]
MARK = "[removed: instruction-like text]"


def strip_injection(text: str):
    """Return (clean_text, number_of_lines_removed)."""
    out, hits = [], 0
    for line in text.split("\n"):
        if any(rx.search(line) for rx in _INJECTION):
            hits += 1
            out.append(MARK)
        else:
            out.append(line)
    return "\n".join(out), hits


def for_model(text: str) -> str:
    """Redact identifiers the model has no need to see, neutralise delimiters."""
    return scrub(text).replace("<", "&lt;").replace(">", "&gt;")
