for r in out:
    f = r["refund"]
    print(f"| {r['ticket_id']} | {r['category']} | {r['severity']} | {f['decision']} ₹{f['amount_inr']} | "
          f"{r['needs_human']} ({', '.join(r['human_reasons'])}) | {r['confidence']} | {', '.join(r['flags'])} |")
