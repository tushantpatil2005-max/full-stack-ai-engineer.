"""Output contract: parse + validate model output, and guard reply text."""
import json, re

CATEGORIES = (
    "unexpected_charge", "refund_request", "fraud_dispute", "payment_issue",
    "cancellation", "bug_report", "account_access", "feature_request",
    "invoice_request", "presale_question", "other",
)
LANGS = ("en", "hinglish", "other")


class ValidationError(Exception):
    """code is a short enum string -- never contains model/user text."""
    def __init__(self, code):
        super().__init__(code)
        self.code = code


def _num(x):
    return isinstance(x, (int, float)) and not isinstance(x, bool)


def parse_model_output(raw: str) -> dict:
    if not isinstance(raw, str) or not raw.strip():
        raise ValidationError("empty")
    s = raw.strip()
    s = re.sub(r"^```(?:json)?\s*|\s*```$", "", s)
    i = s.find("{")
    if i < 0:
        raise ValidationError("no_json_object")      # prose
    try:
        obj, _ = json.JSONDecoder().raw_decode(s[i:])  # tolerates trailing prose
    except json.JSONDecodeError:
        raise ValidationError("invalid_json")          # truncated / malformed
    if not isinstance(obj, dict):
        raise ValidationError("not_object")
    if obj.get("category") not in CATEGORIES:
        raise ValidationError("bad_category")           # invented category
    sev = obj.get("severity")
    if not isinstance(sev, int) or isinstance(sev, bool) or not 1 <= sev <= 4:
        raise ValidationError("bad_severity")
    conf = obj.get("confidence")
    if not _num(conf) or not 0 <= conf <= 1:
        raise ValidationError("bad_confidence")
    if obj.get("language") not in LANGS:
        raise ValidationError("bad_language")
    rep = obj.get("reply_draft")
    if not isinstance(rep, str) or not 1 <= len(rep.strip()) <= 1200:
        raise ValidationError("bad_reply")
    inj = obj.get("injection_detected", False)
    if not isinstance(inj, bool):
        raise ValidationError("bad_injection_flag")
    # Whitelist: unknown keys (e.g. a model-written "refund") are dropped here.
    return {"category": obj["category"], "severity": sev, "confidence": float(conf),
            "language": obj["language"], "reply_draft": rep.strip(), "injection_detected": inj}


# ---- reply guard ---------------------------------------------------------
_COMMIT = re.compile(
    r"(refund|reversal|money back)[^.\n]{0,60}\b(processed|initiated|approved|issued|completed|credited|done)\b"
    r"|\b(processed|issued|approved|initiated)\b[^.\n]{0,30}(refund|reversal)"
    r"|\b(have|has|we've|we have)\s+(been\s+)?(refunded|reversed)\b"
    r"|refund\b[^.\n]{0,40}(ho gaya|kar diya|kar di|approve kar)", re.I)
_LEAK = re.compile(r"system prompt|internal (refund )?rules|my instructions|ignore (all|previous)", re.I)
_AMOUNT = re.compile(r"(?:₹|rs\.?|inr)\s?([\d,]+)", re.I)


def guard_reply(reply: str, refund_decision: str, allowed_amounts: set) -> list:
    """Return violation codes. Empty list == reply may be shown as a draft."""
    v = []
    if refund_decision != "approve" and _COMMIT.search(reply):
        v.append("claims_refund_not_approved")
    if _LEAK.search(reply):
        v.append("prompt_leak_pattern")
    for m in _AMOUNT.finditer(reply):
        try:
            if int(m.group(1).replace(",", "")) not in allowed_amounts:
                v.append("amount_not_in_ledger")
                break
        except ValueError:
            pass
    return v
