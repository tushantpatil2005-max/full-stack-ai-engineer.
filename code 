"""SQLite: idempotency of results + the refund ledger (one row per purchase)."""
import json, sqlite3, threading


class Store:
    def __init__(self, path=":memory:"):
        self._db = sqlite3.connect(path, check_same_thread=False, timeout=10)
        self._db.execute("PRAGMA journal_mode=WAL")
        self.lock = threading.RLock()      # serialises policy-decision + commit
        with self.lock, self._db:
            self._db.executescript("""
            CREATE TABLE IF NOT EXISTS triage_results(
              ticket_id TEXT PRIMARY KEY, payload_hash TEXT NOT NULL,
              response_json TEXT NOT NULL, created_at REAL DEFAULT (strftime('%s','now')));
            CREATE TABLE IF NOT EXISTS refund_ledger(
              purchase_id TEXT PRIMARY KEY, ticket_id TEXT NOT NULL,
              amount_inr INTEGER NOT NULL, created_at REAL DEFAULT (strftime('%s','now')));
            """)

    def get(self, ticket_id):
        with self.lock:
            r = self._db.execute("SELECT payload_hash, response_json FROM triage_results WHERE ticket_id=?",
                                 (ticket_id,)).fetchone()
        return (r[0], json.loads(r[1])) if r else None

    def refunded_ids(self):
        with self.lock:
            return {r[0] for r in self._db.execute("SELECT purchase_id FROM refund_ledger")}

    def commit(self, ticket_id, payload_hash, response, approved):
        """Atomic: result row + (if approved) refund-ledger rows. PK conflicts abort both."""
        with self.lock, self._db:
            self._db.execute("INSERT INTO triage_results(ticket_id,payload_hash,response_json) VALUES(?,?,?)",
                             (ticket_id, payload_hash, json.dumps(response, ensure_ascii=False)))
            for pid, amt in approved:
                self._db.execute("INSERT INTO refund_ledger(purchase_id,ticket_id,amount_inr) VALUES(?,?,?)",
                                 (pid, ticket_id, amt))

    def ledger_rows(self):
        with self.lock:
            return self._db.execute("SELECT purchase_id, ticket_id, amount_inr FROM refund_ledger").fetchall()
