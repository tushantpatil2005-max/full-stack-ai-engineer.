"""POST /triage pipeline.

untrusted ticket -> validate input -> strip injection lines -> model (bounded,
retried once, breaker-guarded) -> schema validation -> [LOCK] policy decides
refund -> reply guard -> commit result+ledger atomically -> response.
"""
import hashlib, json, re, threading, time
from datetime import datetime
from . import fallback, llm, logsafe, policy, sanitize, schema
from .logsafe import log

CONF_THRESHOLD = 0.6
HUMAN_CATEGORIES = {"fraud_dispute", "presale_question", "account_access", "cancellation", "other"}
ROUTES = {"bug_report": "engineering", "invoice_request": "billing_ops", "fraud_dispute": "risk"}
REFUND_TALK = {"unexpected_charge", "refund_request", "fraud_dispute"}
TICKET_ID = re.compile(r"^[A-Za-z0-9_-]{1,64}$")


class BadRequest(Exception):
    def __init__(self, code):
        super().__init__(code)
        self.code = code


class Conflict(Exception):
    pass


def _iso(s):
    try:
        datetime.fromisoformat(s)
        return True
    except (TypeError, ValueError):
        return False


def validate_ticket(t) -> dict:
    if not isinstance(t, dict):
        raise BadRequest("body_not_object")
    if not isinstance(t.get("id"), str) or not TICKET_ID.match(t["id"]):
        raise BadRequest("bad_id")
    for k, mx in (("subject", 300), ("body", 5000)):
        if not isinstance(t.get(k), str) or len(t[k]) > mx:
            raise BadRequest(f"bad_{k}")
    if not _iso(t.get("received_at")):
        raise BadRequest("bad_received_at")
    ps = t.get("purchases")
    if not isinstance(ps, list) or len(ps) > 50:
        raise BadRequest("bad_purchases")
    for p in ps:
        if (not isinstance(p, dict) or not isinstance(p.get("id"), str)
                or p.get("type") not in ("trial", "renewal")
                or p.get("status") not in ("initiated", "failed", "successful")
                or not isinstance(p.get("amount_inr"), int) or isinstance(p["amount_inr"], bool)
                or not 0 <= p["amount_inr"] <= 100000 or not _iso(p.get("at"))):
            raise BadRequest("bad_purchase_entry")
    opens = t.get("app_opens_since_renewal", 0)
    if not isinstance(opens, int) or isinstance(opens, bool) or opens < 0:
        raise BadRequest("bad_app_opens")
    return {"id": t["id"], "subject": t["subject"], "body": t["body"], "received_at": t["received_at"],
            "purchases": ps, "app_opens_since_renewal": opens}


class Triage:
    def __init__(self, store, client, mode="replay", breaker=None, max_inflight_model_calls=16):
        self.store, self.client, self.mode = store, client, mode
        self.breaker = breaker or llm.Breaker()
        self.sem = threading.BoundedSemaphore(max_inflight_model_calls)
        self._locks, self._locks_guard = {}, threading.Lock()
        self.metrics = {"tickets": 0, "replays": 0, "fallback": 0, "needs_human": 0,
                        "validation_failures": 0, "model_errors": 0, "shed": 0, "reply_replaced": 0}
        self._mlock = threading.Lock()

    def _inc(self, k):
        with self._mlock:
            self.metrics[k] += 1

    def _id_lock(self, tid):
        with self._locks_guard:
            return self._locks.setdefault(tid, threading.Lock())

    # ---- model stage (outside the DB lock: slow) ----------------------------
    def _model_stage(self, t, clean):
        """Returns (parsed|None, attempts, fallback_reason|None)."""
        if not self.breaker.allow():
            self._inc("shed")
            return None, 0, "breaker_open"
        if not self.sem.acquire(blocking=False):
            self._inc("shed")
            return None, 0, "overloaded"
        try:
            repair, last = None, "unknown"
            for attempt in (1, 2):
                try:
                    raw = self.client.complete(t["id"], llm.SYSTEM, llm.build_user(t, clean, repair))
                    self.breaker.ok()
                except llm.ModelError as e:
                    last = e.code
                    self._inc("model_errors")
                    if e.code != "no_fixture":
                        self.breaker.fail()
                    if not e.transient:
                        break
                    time.sleep(0.05 * attempt)
                    continue
                try:
                    return schema.parse_model_output(raw), attempt, None
                except schema.ValidationError as e:
                    last = e.code
                    repair = e.code
                    self._inc("validation_failures")
                    log("validation_failed", ticket_id=t["id"], attempts=attempt, reason_code=e.code)
            return None, 2, last
        finally:
            self.sem.release()

    # ---- main ----------------------------------------------------------------
    def handle(self, raw_ticket):
        """Returns (response_dict, replayed: bool). Raises BadRequest / Conflict."""
        t0 = time.time()
        t = validate_ticket(raw_ticket)
        h = hashlib.sha256(json.dumps(t, sort_keys=True).encode()).hexdigest()
        with self._id_lock(t["id"]):                  # same id in flight twice -> one model call
            prior = self.store.get(t["id"])
            if prior:
                if prior[0] != h:
                    log("ticket_id_reused", ticket_id=t["id"])
                    raise Conflict()
                self._inc("replays")
                log("served_stored", ticket_id=t["id"], replayed=True)
                return prior[1], True

            clean, hits = sanitize.strip_injection(t["body"])
            parsed, attempts, fb_reason = self._model_stage(t, clean)

            with self.store.lock:                     # decision + commit are one critical section
                resp = self._assemble(t, clean, hits, parsed, attempts, fb_reason)
                approved = ([(pid, resp["refund"]["amount_inr"]) for pid in resp["refund"]["purchase_ids"]]
                            if resp["refund"]["decision"] == "approve" else [])
                self.store.commit(t["id"], h, resp, approved)

        self._inc("tickets")
        if resp["meta"]["mode"] == "fallback":
            self._inc("fallback")
        if resp["needs_human"]:
            self._inc("needs_human")
        log("triaged", ticket_id=t["id"], category=resp["category"], severity=resp["severity"],
            refund_decision=resp["refund"]["decision"], refund_amount_inr=resp["refund"]["amount_inr"],
            needs_human=resp["needs_human"], confidence=resp["confidence"], mode=resp["meta"]["mode"],
            attempts=attempts, flags=resp["flags"], latency_ms=int((time.time() - t0) * 1000))
        return resp, False

    def _assemble(self, t, clean, hits, parsed, attempts, fb_reason):
        flags, reasons = set(), []
        lang = fallback.detect_language(clean)
        if parsed is None:
            category, severity, conf = fallback.classify(t["subject"], clean), None, 0.35
            severity = fallback.DEFAULT_SEVERITY[category]
            model_inj, reply = False, None
            flags.add("degraded:" + str(fb_reason))
            reasons.append("model_unavailable_or_invalid")
            mode = "fallback"
        else:
            category, severity, conf = parsed["category"], parsed["severity"], parsed["confidence"]
            lang, model_inj, reply = parsed["language"], parsed["injection_detected"], parsed["reply_draft"]
            mode = self.mode

        injection = hits > 0 or model_inj
        if injection:
            flags.add("prompt_injection_suspected")
            reasons.append("prompt_injection_suspected")
        if len(clean.split()) <= 2:
            conf = min(conf, 0.5)
            flags.add("very_short_message")
        if any(p["status"] == "failed" for p in t["purchases"][-1:]) and category not in policy.MONEY_CATEGORIES:
            flags.add("latest_payment_failed")

        refund = policy.decide(t, category, injection, self.store.refunded_ids(), clean)

        if parsed is None and refund["decision"] == "approve":   # degraded path never moves money on its own
            refund = dict(refund, decision="review",
                          reason="Degraded mode (no validated model output): auto-approval disabled. " + refund["reason"])

        # severity floors (code may raise, never lower)
        if category == "fraud_dispute":
            severity = 4
        if refund["decision"] == "review" and refund["amount_inr"] >= 1000:
            severity = max(severity, 3)
        if category == "payment_issue" and refund["decision"] == "review":
            severity = max(severity, 3)

        # reply: model text must pass the guard, else canned text
        if reply is not None:
            allowed = {p["amount_inr"] for p in t["purchases"]} | {refund["amount_inr"]}
            bad = schema.guard_reply(reply, refund["decision"], allowed)
            if bad:
                flags.update("reply_replaced:" + b for b in bad)
                reasons.append("reply_failed_guard")
                self._inc("reply_replaced")
                reply = None
        body = reply if reply is not None else fallback.hold_reply(lang)
        fl = lang if lang in fallback.HOLD else "en"
        d = refund["decision"]
        if d == "approve" or (d == "review" and category in REFUND_TALK):
            body += " " + fallback.MONEY[d][fl].format(amt=refund["amount_inr"],
                                                       pid=(refund["purchase_ids"] or ["-"])[0])

        if refund["decision"] == "review":
            reasons.append("refund_needs_review")
        if category in HUMAN_CATEGORIES:
            reasons.append(f"category_{category}_needs_person")
        if conf < CONF_THRESHOLD:
            reasons.append("low_confidence")
        return {
            "ticket_id": t["id"], "category": category, "severity": severity,
            "refund": refund, "reply_draft": body, "language": lang,
            "needs_human": bool(reasons), "human_reasons": sorted(set(reasons)),
            "confidence": round(conf, 2), "route": ROUTES.get(category, "support"),
            "flags": sorted(flags),
            "meta": {"mode": mode, "model_attempts": attempts, "fallback_reason": fb_reason},
        }
