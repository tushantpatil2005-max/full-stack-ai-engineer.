"""stdlib HTTP server. POST /triage, GET /healthz, GET /metrics."""
import argparse, json, os, sys
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from . import llm, logsafe
from .logsafe import log
from .store import Store
from .triage import BadRequest, Conflict, Triage

MAX_BODY = 64 * 1024


def make_handler(svc: Triage):
    class H(BaseHTTPRequestHandler):
        def log_message(self, *a):   # default access log is silenced; we log via logsafe only
            pass

        def _send(self, code, obj, headers=None):
            data = json.dumps(obj, ensure_ascii=False).encode()
            self.send_response(code)
            self.send_header("Content-Type", "application/json; charset=utf-8")
            self.send_header("Content-Length", str(len(data)))
            for k, v in (headers or {}).items():
                self.send_header(k, v)
            self.end_headers()
            self.wfile.write(data)

        def do_GET(self):
            if self.path == "/healthz":
                return self._send(200, {"ok": True, "mode": svc.mode})
            if self.path == "/metrics":
                return self._send(200, svc.metrics)
            self._send(404, {"error": "not_found"})

        def do_POST(self):
            if self.path != "/triage":
                return self._send(404, {"error": "not_found"})
            try:
                n = int(self.headers.get("Content-Length", "0"))
                if not 0 < n <= MAX_BODY:
                    return self._send(413 if n > MAX_BODY else 400, {"error": "bad_length"})
                try:
                    payload = json.loads(self.rfile.read(n))
                except ValueError:
                    return self._send(400, {"error": "invalid_json"})
                resp, replayed = svc.handle(payload)
                out = dict(resp)
                out["meta"] = dict(resp["meta"], replayed=replayed)
                self._send(200, out, {"Idempotent-Replay": "true"} if replayed else None)
            except BadRequest as e:
                self._send(400, {"error": e.code})
            except Conflict:
                self._send(409, {"error": "ticket_id_reused_with_different_content"})
            except Exception as e:      # class name only: messages can quote ticket text
                log("unhandled", error_class=type(e).__name__)
                self._send(500, {"error": "internal"})
    return H


def build(mode, db, fixtures):
    client = llm.ReplayClient(fixtures) if mode == "replay" else llm.LiveClient() if mode == "live" else None
    if client is None:   # mode == "fallback": force degraded path
        class Dead:
            def complete(self, *a):
                raise llm.ModelError("forced_fallback", transient=False)
        client = Dead()
    return Triage(Store(db), client, mode=mode)


def main(argv=None):
    ap = argparse.ArgumentParser()
    ap.add_argument("--mode", choices=["live", "replay", "fallback"], default=os.environ.get("DHABA_MODE", "replay"))
    ap.add_argument("--db", default=os.environ.get("DHABA_DB", "dhaba.db"))
    ap.add_argument("--fixtures", default=os.environ.get("DHABA_FIXTURES", "fixtures/model_replay.json"))
    ap.add_argument("--port", type=int, default=int(os.environ.get("PORT", "8080")))
    a = ap.parse_args(argv)
    svc = build(a.mode, a.db, a.fixtures)
    srv = ThreadingHTTPServer(("127.0.0.1", a.port), make_handler(svc))
    log("listening", mode=a.mode, status=a.port)
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
