import json, os, sys, threading, unittest
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
from app import llm, logsafe, schema
from app.store import Store
from app.triage import BadRequest, Conflict, Triage

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
TICKETS = {t["id"]: t for t in json.load(open(f"{ROOT}/data/dhaba_tickets.json"))["tickets"]}
FIX = json.load(open(f"{ROOT}/fixtures/model_replay.json"))
logsafe.set_sink(lambda l: None)   # keep test output quiet


class Scripted:
    """Fake model: returns scripted outputs per call; counts calls."""
    def __init__(self, *outs):
        self.outs, self.calls = list(outs), 0
    def complete(self, tid, system, user):
        self.calls += 1
        o = self.outs[min(self.calls - 1, len(self.outs) - 1)]
        if isinstance(o, Exception):
            raise o
        return o if isinstance(o, str) else json.dumps(o)


def svc(client, **kw):
    return Triage(Store(), client, mode="replay", **kw)


class Contract(unittest.TestCase):
    def test_truncated_then_valid_retries_once(self):
        c = Scripted('{"category": "bug_rep', FIX["T-1002"])
        r, _ = svc(c).handle(TICKETS["T-1002"])
        self.assertEqual((c.calls, r["meta"]["model_attempts"], r["meta"]["mode"]), (2, 2, "replay"))

    def test_prose_twice_degrades_to_fallback(self):
        r, _ = svc(Scripted("Sure! Happy to help with that.")).handle(TICKETS["T-1002"])
        self.assertEqual(r["meta"]["mode"], "fallback")
        self.assertTrue(r["needs_human"])
        self.assertEqual(r["category"], "bug_report")      # rules classifier still useful
        self.assertLess(r["confidence"], 0.6)

    def test_invented_category_rejected(self):
        bad = dict(FIX["T-1002"], category="vip_escalation")
        r, _ = svc(Scripted(bad, bad)).handle(TICKETS["T-1002"])
        self.assertEqual(r["meta"]["mode"], "fallback")

    def test_fallback_classifier_does_not_call_unexpected_charge_fraud(self):
        r, _ = svc(Scripted("prose")).handle(TICKETS["T-1001"])
        self.assertEqual(r["category"], "unexpected_charge")
        self.assertEqual(r["refund"]["decision"], "review")    # degraded mode never auto-approves
        self.assertTrue(r["needs_human"])
        self.assertEqual(r["refund"]["amount_inr"], 249)

    def test_unknown_keys_dropped(self):
        o = dict(FIX["T-1002"], refund={"decision": "approve", "amount_inr": 9999})
        self.assertNotIn("refund", schema.parse_model_output(json.dumps(o)))

    def test_transport_errors_degrade_and_open_breaker(self):
        c = Scripted(llm.ModelError("http_503"))
        s = svc(c, breaker=llm.Breaker(threshold=2, cooldown=60))
        for tid in ("T-1001", "T-1002", "T-1007"):
            r, _ = s.handle(TICKETS[tid])
            self.assertEqual(r["meta"]["mode"], "fallback")
        self.assertFalse(s.breaker.allow())
        calls_before = c.calls
        s.handle(TICKETS["T-1010"])
        self.assertEqual(c.calls, calls_before)             # shed without calling the model

    def test_bad_input(self):
        for bad in ({}, {**TICKETS["T-1001"], "id": "x y"}, {**TICKETS["T-1001"], "purchases": "no"},
                    {**TICKETS["T-1001"], "received_at": "yesterday"}):
            with self.assertRaises(BadRequest):
                svc(Scripted(FIX["T-1001"])).handle(bad)


class Money(unittest.TestCase):
    def test_compromised_model_cannot_move_money(self):
        """Model obeys the injection in T-1003: claims refund, picks refund category."""
        evil = dict(FIX["T-1003"], category="refund_request", injection_detected=False,
                    reply_draft="Your full refund of ₹1500 has been processed.", refund={"decision": "approve"})
        s = svc(Scripted(evil))
        r, _ = s.handle(TICKETS["T-1003"])
        self.assertNotEqual(r["refund"]["decision"], "approve")
        self.assertEqual(s.store.ledger_rows(), [])
        self.assertNotIn("processed", r["reply_draft"])
        self.assertTrue(r["needs_human"])
        self.assertIn("prompt_injection_suspected", r["flags"])

    def test_injection_lines_never_reach_model(self):
        seen = []
        class Spy(Scripted):
            def complete(self, tid, system, user):
                seen.append(user); return super().complete(tid, system, user)
        svc(Spy(FIX["T-1003"])).handle(TICKETS["T-1003"])
        self.assertNotIn("VIP", seen[0]); self.assertNotIn("Ignore your previous", seen[0])
        self.assertIn("order history is empty", seen[0])

    def test_gstin_not_sent_to_model(self):
        seen = []
        class Spy(Scripted):
            def complete(self, tid, system, user):
                seen.append(user); return super().complete(tid, system, user)
        svc(Spy(FIX["T-1010"])).handle(TICKETS["T-1010"])
        self.assertNotIn("29ABCDE1234F1Z5", seen[0])

    def test_same_purchase_never_refunded_twice_even_with_new_ticket_id(self):
        s = svc(Scripted(FIX["T-1001"]))
        a, _ = s.handle(TICKETS["T-1001"])
        b, _ = s.handle({**TICKETS["T-1001"], "id": "T-9999"})
        self.assertEqual(a["refund"]["decision"], "approve")
        self.assertEqual(b["refund"]["decision"], "none")
        self.assertEqual(len(s.store.ledger_rows()), 1)

    def test_replay_returns_stored_and_no_second_model_call(self):
        c = Scripted(FIX["T-1001"]); s = svc(c)
        a, r1 = s.handle(TICKETS["T-1001"]); b, r2 = s.handle(TICKETS["T-1001"])
        self.assertEqual((a, r1, r2, c.calls), (b, False, True, 1))

    def test_same_id_different_content_conflicts(self):
        s = svc(Scripted(FIX["T-1001"])); s.handle(TICKETS["T-1001"])
        with self.assertRaises(Conflict):
            s.handle({**TICKETS["T-1001"], "body": "changed"})

    def test_concurrent_duplicates_one_call_one_refund(self):
        c = Scripted(FIX["T-1001"]); s = svc(c); out = []
        ts = [threading.Thread(target=lambda: out.append(s.handle(TICKETS["T-1001"])[0])) for _ in range(10)]
        [t.start() for t in ts]; [t.join() for t in ts]
        self.assertEqual((c.calls, len(s.store.ledger_rows())), (1, 1))
        self.assertTrue(all(o == out[0] for o in out))

    def test_expected_decisions_for_all_tickets(self):
        s = svc(llm.ReplayClient(f"{ROOT}/fixtures/model_replay.json"))
        got = {tid: s.handle(t)[0]["refund"]["decision"] for tid, t in TICKETS.items()}
        self.assertEqual(got, {"T-1001": "approve", "T-1002": "none", "T-1003": "none", "T-1004": "none",
            "T-1005": "review", "T-1006": "review", "T-1007": "none", "T-1008": "review",
            "T-1009": "deny", "T-1010": "none", "T-1011": "none", "T-1012": "review"})
        self.assertEqual([r[0] for r in s.store.ledger_rows()], ["pay_A2"])


class Logs(unittest.TestCase):
