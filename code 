        "hinglish": "Humne payment {pid} ke ₹{amt} ka refund approve kar diya hai. Refund aam taur par 5–7 working days mein account mein aa jaata hai.",
    },
    "review": {
        "en": "Your refund request is with our team for review. We'll update you once it's checked.",
        "hinglish": "Aapka refund request hamari team ke review mein hai. Check hone ke baad hum aapko update denge.",
    },
}
DEFAULT_SEVERITY = {"fraud_dispute": 4, "payment_issue": 3, "bug_report": 3, "cancellation": 3,
                    "unexpected_charge": 2, "refund_request": 2, "account_access": 2,
                    "feature_request": 1, "invoice_request": 1, "presale_question": 1, "other": 2}
_RULES = [  # first match wins; order matters
    ("fraud_dispute", r"fraud|cyber|never installed|unauthori[sz]ed"),
    ("invoice_request", r"\binvoice\b|\bgst"),
    ("bug_report", r"crash|closes immediately|not opening|keeps closing|error"),
    ("cancellation", r"\bcancel"),
    ("unexpected_charge", r"twice|double|without telling|autopay|auto-?renew|charged me"),
    ("payment_issue", r"paisa kat|debited|not activated|activate nahi|plan activate|payment failed"),
    ("refund_request", r"refund|money back|paisa wapas"),
    ("account_access", r"restore|login|log in|sign in|history|account"),
    ("feature_request", r"add .*(language|feature|dark)|feature request|can you add"),
    ("presale_question", r"before i subscribe|does .*(premium|plan).* work|how much"),
]


def detect_language(text: str) -> str:
    if re.search(r"[\u0900-\u097F]", text):
        return "other"
    words = set(re.findall(r"[a-z]+", text.lower()))
    return "hinglish" if len(words & HINGLISH) >= 2 else "en"


def classify(subject: str, body: str) -> str:
    t = f"{subject}\n{body}".lower()
    for cat, rx in _RULES:
        if re.search(rx, t):
            return cat
    return "other"


def hold_reply(lang: str) -> str:
    return HOLD.get(lang, HOLD["en"])
