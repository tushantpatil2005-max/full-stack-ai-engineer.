"""The money gate. Pure code, no model.

The model never writes `refund`. It supplies a *category*; this module turns
(category, billing facts, ledger of past refunds) into a decision. Even a
fully compromised model can only pick a category -- the worst it can cause is
a `review` (a human looks), never an `approve`, because:
  * approve needs an unused (0 opens) monthly renewal inside the window, and
  * approve is blocked entirely if the ticket contained injection-like text.
Policy numbers below are MY assumptions (no policy was supplied); see README.
"""
import re
from datetime import datetime

AUTO_APPROVE_CAP_INR = 249     # annual plan (1499) always goes to a human
AUTO_APPROVE_WINDOW_DAYS = 7
MONEY_CATEGORIES = {"unexpected_charge", "refund_request", "fraud_dispute", "payment_issue"}
_DUP_CLAIM = re.compile(r"\b(twice|double|two times|2 times|dobara|do baar)\b", re.I)


def _t(s):
    return datetime.fromisoformat(s)


def _r(decision, amount, pids, reason):
    return {"decision": decision, "amount_inr": amount, "purchase_ids": pids, "reason": reason}


def decide(ticket: dict, category: str, injection: bool, refunded: set, clean_body: str) -> dict:
    if category not in MONEY_CATEGORIES:
        return _r("none", 0, [], "No money action for this category.")
    ps = ticket["purchases"]
    now = _t(ticket["received_at"])     # ticket time, not wall clock: replayable
    ok = [p for p in ps if p["status"] == "successful"]

    if category == "fraud_dispute":
        total = sum(p["amount_inr"] for p in ok)
        return _r("review", total, [p["id"] for p in ok],
                  "Unauthorised-charge claim: a human must verify before any money moves. "
                  f"Amount shown is the sum of {len(ok)} successful charge(s) on file.")

    if category == "payment_issue" and ps:
        last = max(ps, key=lambda p: _t(p["at"]))
        if last["status"] in ("initiated", "failed"):
            return _r("review", 0, [last["id"]],
                      f"Billing shows the latest payment as '{last['status']}', not successful. "
                      "Nothing to refund on our side yet; reconcile with the payment gateway, "
                      f"then activate the plan or refund Rs {last['amount_inr']}.")

    # duplicate-charge claims: only the ledger can confirm
    if _DUP_CLAIM.search(clean_body):
        by_day = {}
        for p in ok:
            if p["type"] == "renewal":
                by_day.setdefault((p["amount_inr"], _t(p["at"]).date()), []).append(p)
        dups = [v for v in by_day.values() if len(v) > 1]
        if not dups:
            failed = sum(1 for p in ps if p["status"] == "failed")
            return _r("deny", 0, [], f"Ledger shows one successful charge and {failed} failed attempt(s); "
                                     "no duplicate collected. A failed attempt can appear as a temporary bank hold.")
        second = sorted(dups[0], key=lambda p: p["at"])[-1]
        return _finish(second, 0, now, injection, refunded, dup=True)

    renewals = [p for p in ok if p["type"] == "renewal"]
    if not renewals:
        return _r("deny", 0, [], "Only the Rs 1 trial is on file; trial fee is non-refundable.")
    target = max(renewals, key=lambda p: _t(p["at"]))
    return _finish(target, ticket.get("app_opens_since_renewal", 0), now, injection, refunded)


def _finish(target, opens, now, injection, refunded, dup=False):
    pid, amt = target["id"], target["amount_inr"]
    if pid in refunded:
        return _r("none", 0, [pid], f"{pid} was already refunded; not refunding twice.")
    age = (now - _t(target["at"])).total_seconds() / 86400
    why = f"{pid} (Rs {amt}) charged {age:.1f} day(s) before the ticket; {opens} app open(s) since."
    if injection:
        return _r("review", amt, [pid], "Ticket contained instruction-like text; auto-approval disabled. " + why)
    if amt > AUTO_APPROVE_CAP_INR:
        return _r("review", amt, [pid], f"Amount above auto-approve cap (Rs {AUTO_APPROVE_CAP_INR}). " + why)
    if dup:
        return _r("approve", amt, [pid], "Duplicate successful charge same day. " + why)
    if opens == 0 and age <= AUTO_APPROVE_WINDOW_DAYS:
        return _r("approve", amt, [pid], "Unused renewal inside refund window. " + why)
    return _r("review", amt, [pid], "Used or outside window; a human decides. " + why)
