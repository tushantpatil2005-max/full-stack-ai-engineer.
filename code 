app/logsafe.py
"""Logging that cannot leak ticket content.

Two layers:
1. Allow-list: only the keys in ALLOWED are ever written. There is no
   log(msg) path, so nobody can accidentally interpolate a body/subject.
2. Scrub: every string value is regex-scrubbed for emails, phones, GSTINs.
Exceptions are logged as class name only (e.g. JSONDecodeError messages
can quote the input).
"""
import json, re, sys, threading, time

ALLOWED = {
    "ticket_id", "category", "severity", "refund_decision", "refund_amount_inr",
    "needs_human", "confidence", "mode", "attempts", "latency_ms", "outcome",
    "flags", "error_class", "status", "replayed", "breaker", "reason_code",
}
_SCRUBBERS = [
    (re.compile(r"[\w.+-]+@[\w-]+\.[\w.]+"), "[email]"),
    (re.compile(r"\b\d{2}[A-Z]{5}\d{4}[A-Z][A-Z\d]Z[A-Z\d]\b"), "[gstin]"),
    (re.compile(r"(?<!\d)(?:\+?91[\s-]?)?[6-9]\d{9}(?!\d)"), "[phone]"),
]
_lock = threading.Lock()
_sink = lambda line: sys.stderr.write(line + "\n")


def set_sink(fn):
    global _sink
    _sink = fn


def scrub(v):
    if isinstance(v, str):
        for rx, rep in _SCRUBBERS:
            v = rx.sub(rep, v)
        return v
    if isinstance(v, (list, tuple)):
        return [scrub(x) for x in v]
    return v


def log(event: str, **fields):
    rec = {"ts": round(time.time(), 3), "event": event}
    for k, v in fields.items():
        if k in ALLOWED:
            rec[k] = scrub(v)
    with _lock:
        _sink(json.dumps(rec, ensure_ascii=False))
